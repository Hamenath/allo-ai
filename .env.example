# Firebase Client Configuration (Public — Safe to expose to client)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Cloud & Workload Identity Federation (Server-side ONLY — Keyless)
GCP_PROJECT_ID=your_project_id
GCP_PROJECT_NUMBER=your_gcp_project_number
GCP_SERVICE_ACCOUNT_EMAIL=allo-backend-admin@your_project_id.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-allo-production
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=vercel-allo
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel-allo

# Legacy Firebase Admin SDK Credentials (Optional / Dev fallback)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Google Gemini AI API (Server-side ONLY — NEVER expose to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Billing Credentials (India-first monetization)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Application Base URL
# Local Dev: http://localhost:3000
# Production: https://YOUR-VERCEL-PROJECT-NAME.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Access Email (Server-side ONLY)
ADMIN_EMAIL=your-real-email@example.com

# Support & Legal Email Overrides (Optional Public Configuration)
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@example.com
NEXT_PUBLIC_LEGAL_EMAIL=legal@example.com

# Transactional Email Configuration (Resend / SMTP — Server-side ONLY)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="ALLO <notifications@example.com>"
EMAIL_REPLY_TO=support@example.com

# Distributed Rate Limiting (Upstash Redis — Server-side ONLY)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
